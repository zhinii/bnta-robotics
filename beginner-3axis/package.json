{
  "name": "bnta-robot-challenges",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ipad": "node tests/challenge-ipad.browser.mjs",
    "test:dom": "node tests/challenge.dom.mjs",
    "test:challenges": "node --test tests/challenge.test.mjs tests/challenge-contact.test.mjs",
    "test:browser": "node tests/challenge.browser.mjs",
    "test:lessons:ai": "node tests/quest-lessons.ai.dom.mjs",
    "test:quest:browser": "node tests/quest-lessons.browser.mjs",
    "test:guide": "node --test tests/guide-commands.test.mjs tests/guide-ai.test.mjs && node tests/guide.dom.mjs",
    "test:dom:legacy": "node tests/lesson-flow.dom.mjs && node tests/ui.dom.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
