{
  "name": "bnta-three-axis-learning-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:dom": "node tests/quest-lessons.dom.mjs && node tests/guide.dom.mjs",
    "test:lessons:ai": "node tests/quest-lessons.ai.dom.mjs",
    "test:quest:browser": "node tests/quest-lessons.browser.mjs",
